---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy" description="How Dirt & Dollars handles your email address and site data.">
  <section class="section"><div class="wrap prose">
    <h1>Privacy</h1>
    <p>If you subscribe to The Fence Post, your email address is stored with our email provider, Kit (ConvertKit), and used only to send the newsletter. We never sell or share it. Every email has a one-click unsubscribe link.</p>
    <p>This site uses no advertising trackers. Embedded YouTube videos load from youtube-nocookie.com and are subject to Google's privacy policy once you press play.</p>
    <p>Questions or deletion requests: <a href="mailto:hello@thedirtanddollarswebsite.com">hello@thedirtanddollarswebsite.com</a>.</p>
    <p class="muted">Last updated October 1, 2026.</p>
  </div></section>
</Base>
