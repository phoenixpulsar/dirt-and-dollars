---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="section"><div class="wrap stack" style="gap: 20px; max-width: 720px">
    <p class="kicker">404</p>
    <h1>This gate's closed.</h1>
    <p class="lede">The page you're looking for wandered off. Head back to the pasture.</p>
    <a class="btn btn-copper" href="/" style="align-self: flex-start">Go home</a>
  </div></section>
</Base>
